[Unit]
Description=SzaBee Rich Presence Sender
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.szabee-presence
EnvironmentFile=-%h/.config/szabee-presence/env
Environment=SZABEE_PRESENCE_API=https://szabee.me/api/presence
Environment=SZABEE_PRESENCE_POLL_SECONDS=5
ExecStart=/usr/bin/python -m presence_sender
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
